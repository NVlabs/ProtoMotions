<mujoco model="two_joint_external_floor">
  <worldbody>
    <body name="root" pos="0 0 1">
      <freejoint/>
      <geom name="root_collision" type="sphere" size="0.05"/>
      <body name="link" pos="0 0 -0.2">
        <joint name="hinge" type="hinge" axis="0 1 0"/>
        <geom name="link_collision" type="capsule" size="0.03" fromto="0 0 0 0 0 -0.2"/>
      </body>
    </body>
  </worldbody>
  <contact>
    <pair name="external_floor_contact" geom1="link_collision" geom2="floor"/>
  </contact>
</mujoco>
